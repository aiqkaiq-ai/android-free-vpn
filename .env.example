# Mudrex API Credentials
# Get these from: https://www.mudrex.com/settings/api
MUDREX_API_KEY=your_api_key_here
MUDREX_API_SECRET=your_api_secret_here

# Trading Settings
# Set to 'true' to enable automated trading
# Set to 'false' to run in TEST MODE (signals only, no real trades)
ENABLE_AUTO_TRADING=false

# Trading Pairs (comma-separated)
# Examples: BTCUSDT, ETHUSDT, ADAUSDT, XRPUSDT
TRADING_PAIRS=BTCUSDT,ETHUSDT,ADAUSDT,XRPUSDT

# Risk Management (percentage values)
# Risk per trade as % of account balance
RISK_PER_TRADE=2

# Stop loss percentage below entry price
STOP_LOSS_PERCENT=2

# Take profit percentage above entry price
TAKE_PROFIT_PERCENT=5

# Monitoring Intervals
# How often to check prices (milliseconds)
CHECK_INTERVAL_MS=5000

# How often to log statistics (minutes)
LOG_INTERVAL=5

# API Base URL (usually don't need to change)
MUDREX_BASE_URL=https://api.mudrex.com/v1
